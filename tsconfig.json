{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    // Without this, tsc auto-includes every node_modules/@types/* package in the
    // server program. Adding @types/react for the UI would silently inject the DOM
    // globals into src/ and test/, where a stray `document` or `Element` would then
    // typecheck instead of erroring. Pin the server's ambient types to node only.
    "types": ["node"],
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": true
  },
  "include": ["src/**/*", "test/**/*"]
}
