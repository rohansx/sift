{
  "name": "@siftlabs/sift",
  "version": "0.1.0",
  "description": "Sentry-grade issue tracking for agent behavior. Open source trace intelligence over OpenTelemetry GenAI spans.",
  "type": "module",
  "bin": {
    "sift": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "test:watch": "node --test --watch \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\" && npm run build:ui",
    "build:ui": "tsc -p ui/tsconfig.json --noEmit && vite build --config ui/vite.config.ts",
    "ui:dev": "vite --config ui/vite.config.ts",
    "prepack": "npm run build",
    "check": "npm run typecheck && npm test",
    "demo": "node src/cli.ts demo",
    "bench": "node src/examples/benchmark.ts"
  },
  "keywords": [
    "opentelemetry",
    "otel",
    "observability",
    "llm-observability",
    "agent-observability",
    "ai-agents",
    "llmops",
    "genai",
    "llm",
    "evals",
    "tracing",
    "clustering",
    "trace-analysis"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {},
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.0"
  },
  "license": "Apache-2.0"
}
